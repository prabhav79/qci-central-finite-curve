## 6. Target Database Schema (PostgreSQL 16 + pgvector)

```sql
-- Enable vector extension
CREATE EXTENSION IF NOT EXISTS vector;

-- 1. Users & Hierarchy
CREATE TABLE users (
    id SERIAL PRIMARY KEY,
    employee_id VARCHAR(50) UNIQUE,
    full_name VARCHAR(255) NOT NULL,
    email VARCHAR(255) UNIQUE NOT NULL,
    password_hash VARCHAR(255) NOT NULL,
    designation VARCHAR(150) NOT NULL,     -- 'Secretary General', 'Senior Project Manager', 'Project Manager', 'Analyst'
    grade VARCHAR(100),                    -- 'Grade - Regular', 'Grade - Senior Professional', 'Grade - Young Professional'
    division_or_board VARCHAR(100),        -- 'PPID', 'NABH', 'NABL', 'NBQP', 'TCB'
    manager_id INTEGER REFERENCES users(id),-- Recursive self-reference: Line Manager
    is_admin BOOLEAN DEFAULT FALSE,        -- True for Prabhav Kumar Singh
    is_active BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMPTZ DEFAULT NOW()
);

-- 2. Documents Registry
CREATE TABLE documents (
    id SERIAL PRIMARY KEY,
    doc_id VARCHAR(255) UNIQUE NOT NULL,
    filename VARCHAR(500) NOT NULL,
    category VARCHAR(100),                 -- 'work_order', 'proposal', 'report', 'amendment'
    division_or_board VARCHAR(100),        -- 'PPID', 'DPIIT'
    project_vertical VARCHAR(100),         -- 'DARPG', 'Sanitation', 'Impact Assessment'
    project_name VARCHAR(255),
    client_or_ministry VARCHAR(255),
    issue_date VARCHAR(50),
    value_inr NUMERIC,
    deliverables TEXT,
    raw_text TEXT,
    raw_file_path TEXT,
    uploader_id INTEGER REFERENCES users(id),
    created_at TIMESTAMPTZ DEFAULT NOW()
);

-- 3. Document Chunks & Embeddings (Vector Search)
CREATE TABLE document_chunks (
    id SERIAL PRIMARY KEY,
    document_id INTEGER REFERENCES documents(id) ON DELETE CASCADE,
    chunk_index INTEGER NOT NULL,
    chunk_text TEXT NOT NULL,
    embedding vector(768),                 -- Gemini text-embedding-004 (768) or 384 for MiniLM
    metadata JSONB
);

CREATE INDEX idx_chunks_embedding ON document_chunks 
    USING hnsw (embedding vector_cosine_ops);

-- 4. Multi-Tier Approval Workflow
CREATE TABLE document_approvals (
    id SERIAL PRIMARY KEY,
    document_id INTEGER REFERENCES documents(id),
    maker_id INTEGER REFERENCES users(id),
    l1_manager_id INTEGER REFERENCES users(id),
    l2_manager_id INTEGER REFERENCES users(id),
    status VARCHAR(50) DEFAULT 'DRAFT',    -- 'DRAFT', 'PENDING_L1_REVIEW', 'APPROVED_L1_PENDING_L2', 'FINAL_APPROVED', 'REJECTED'
    l1_comments TEXT,
    l1_reviewed_at TIMESTAMPTZ,
    l2_comments TEXT,
    l2_reviewed_at TIMESTAMPTZ,
    final_version_path TEXT,
    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- 5. User LLM Configuration (Encrypted)
CREATE TABLE user_llm_configs (
    id SERIAL PRIMARY KEY,
    user_id INTEGER REFERENCES users(id) ON DELETE CASCADE,
    provider VARCHAR(50) NOT NULL,         -- 'gemini', 'openai', 'anthropic'
    api_key_encrypted TEXT NOT NULL,
    model_name VARCHAR(100),
    is_active BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMPTZ DEFAULT NOW()
);

-- 6. Comprehensive Audit Trail
CREATE TABLE audit_logs (
    id SERIAL PRIMARY KEY,
    user_id INTEGER REFERENCES users(id),
    action VARCHAR(100) NOT NULL,          -- 'QUERY_RAG', 'DRAFT_GENERATED', 'APPROVED_L1', 'APPROVED_L2', 'DOWNLOAD_DOC'
    target_id VARCHAR(255),
    metadata JSONB,
    created_at TIMESTAMPTZ DEFAULT NOW()
);
