{
  "name": "@cfc/api",
  "version": "0.1.0",
  "private": true,
  "description": "CFC FastAPI domain service (Python). npm scripts proxy to uvicorn.",
  "scripts": {
    "dev": "python -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000 --app-dir .",
    "start": "python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --app-dir ."
  }
}
